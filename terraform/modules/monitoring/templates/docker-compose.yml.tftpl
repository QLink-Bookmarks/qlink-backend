x-logging: &default-logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  prometheus:
    image: ${prometheus_image}
    container_name: prometheus
    restart: unless-stopped
    logging: *default-logging
    mem_limit: ${prometheus_mem_limit}
    environment:
      - GOMEMLIMIT=${prometheus_memory_limit}
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time=${prometheus_retention}"
      - "--storage.tsdb.retention.size=${prometheus_retention_size}"
      - "--query.max-samples=${prometheus_max_samples}"
      - "--web.enable-lifecycle"
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ${data_mount_path}/prometheus:/prometheus
    expose:
      - "9090"

  node-exporter:
    image: ${node_exporter_image}
    container_name: node-exporter
    restart: unless-stopped
    logging: *default-logging
    mem_limit: ${node_exporter_mem_limit}
    pid: host
    command:
      - "--path.rootfs=/host"
      - "--collector.disable-defaults"
      - "--collector.cpu"
      - "--collector.meminfo"
      - "--collector.filesystem"
      - "--collector.diskstats"
      - "--collector.netdev"
      - "--collector.loadavg"
    volumes:
      - /:/host:ro,rslave
    expose:
      - "9100"

  grafana:
    image: ${grafana_image}
    container_name: grafana
    restart: unless-stopped
    logging: *default-logging
    mem_limit: ${grafana_mem_limit}
    depends_on:
      - prometheus
    environment:
      - GOMEMLIMIT=${grafana_memory_limit}
      - GF_SECURITY_ADMIN_PASSWORD=$${GRAFANA_ADMIN_PASSWORD}
      - GF_SERVER_ROOT_URL=https://$${GRAFANA_DOMAIN}
      - GF_USERS_ALLOW_SIGN_UP=false
      - GF_ANALYTICS_REPORTING_ENABLED=false
      - GF_ANALYTICS_CHECK_FOR_UPDATES=false
    volumes:
      - ${data_mount_path}/grafana:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
    ports:
      - "${grafana_port}:3000"
