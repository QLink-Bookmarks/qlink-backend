{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOwnPreviewBucketForHeadObject",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::alink-previews-${aws:PrincipalTag/alinkEnvironment}",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalTag/alinkEnvironment": ["dev", "prod"]
        }
      }
    },
    {
      "Sid": "ReadWriteOwnPreviewObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::alink-previews-${aws:PrincipalTag/alinkEnvironment}/${aws:PrincipalTag/alinkEnvironment}-preview-*",
        "arn:aws:s3:::alink-previews-${aws:PrincipalTag/alinkEnvironment}/${aws:PrincipalTag/alinkEnvironment}-favicon-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:PrincipalTag/alinkEnvironment": ["dev", "prod"]
        }
      }
    },
    {
      "Sid": "WriteOwnLambdaLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:ap-northeast-2:650177546654:log-group:/aws/lambda/alink-link-preview-${aws:PrincipalTag/alinkEnvironment}:*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalTag/alinkEnvironment": ["dev", "prod"]
        }
      }
    }
  ]
}
