{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListPreviewBucketsForHeadObject",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": [
        "arn:aws:s3:::alink-previews-dev",
        "arn:aws:s3:::alink-previews-prod"
      ]
    },
    {
      "Sid": "ReadWritePreviewObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::alink-previews-dev/dev-preview-*",
        "arn:aws:s3:::alink-previews-dev/dev-favicon-*",
        "arn:aws:s3:::alink-previews-prod/prod-preview-*",
        "arn:aws:s3:::alink-previews-prod/prod-favicon-*"
      ]
    },
    {
      "Sid": "WritePreviewLambdaLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": [
        "arn:aws:logs:ap-northeast-2:650177546654:log-group:/aws/lambda/alink-link-preview-dev:*",
        "arn:aws:logs:ap-northeast-2:650177546654:log-group:/aws/lambda/alink-link-preview-prod:*"
      ]
    }
  ]
}
